# The builder's chat picks a provider in this order:
#   1. OpenRouter  (if OPENROUTER_API_KEY is set)
#   2. Anthropic   (if ANTHROPIC_API_KEY is set)
#   3. Built-in simulation (no key needed — the demo always works)

# --- OpenRouter (recommended) --------------------------------------------
# OpenAI-compatible; can route to Claude, GPT, Llama, etc.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models (default below).
OPENROUTER_MODEL=z-ai/glm-5.2

# --- Anthropic (direct) --------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
