# Meridian environment. Copy to .env.local and fill in. Never commit real secrets.

# PostgreSQL connection string
DATABASE_URL="postgresql://meridian:meridian@localhost:5432/meridian?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL of the app (used by Auth.js in production)
AUTH_URL="http://localhost:3000"
